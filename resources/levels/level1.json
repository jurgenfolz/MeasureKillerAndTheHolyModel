  "dialogs": {
    "intro": [
      {
        "speaker": "pedro",
        "text": "Measure Killer! You're awake. Good. We have a problem."
      },
      {
        "speaker": "pedro",
        "text": "They made a mess in our Holy Model again..."
      },
      {
        "speaker": "player",
        "text": "Unused measures again, Master?"
      },
      {
        "speaker": "pedro",
        "text": "Unused measures, unused columns, and many-to-many relationships..."
      },
      {
        "speaker": "pedro",
        "text": "I suspect it was him again..."
      },
      {
        "speaker": "player",
        "text": "Who? not the Crossjoin Maniac? Master, I thought we defeated him!"
      },
      {
        "speaker": "pedro",
        "text": "Me too, but somehow his spirit survived. And now he is back, destroying our Holy Model again!"
      },
      {
        "speaker": "pedro",
        "text": "But enough talk, to restore order, you need to kill all unused measures, columns and many-to-many relationships and defeat the Crossjoin Maniac!"
      },
      {
        "speaker": "player",
        "text": "Understood, Master! I will restore order to the Holy Model!"
      }

    ]
  },
  "triggers": [
    {
      "name": "dirt_wall",
      "x": 12,
      "say": "A dirt wall! My sword can dig through it. I'll aim high and low to make a tunnel."
    }
